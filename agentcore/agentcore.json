      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupport",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "X-Amzn-Bedrock-AgentCore-Runtime-Custom-User-Id",
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_BIB0kNjzu/.well-known/openid-configuration",
          "allowedClients": [
            "7c6f6kt126saaj458mujuuese0",
            "1v1gigo6336v0tfnnt81muegr"
          ]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "SharedMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "my-gateway-secure",
      "protocolType": "None",
      "targets": [
        {
          "name": "WarrantyCheck",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:944593153933:function:workshop-warranty-check",
            "toolSchemaFile": "app/CustomerSupport/tool/warranty_schema.json"
          }
        },
        {
          "name": "WebSearch",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "parameterValues": {
                "maxResults": 10
              }
            }
          ]
        }
      ],
      "authorizerType": "CUSTOM_JWT",
